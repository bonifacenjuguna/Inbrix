# ── Telegram ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id. Everyone else is silently ignored.
# Get yours from @userinfobot on Telegram.
TELEGRAM_OWNER_ID=

# ── Google OAuth (Gmail API) ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Obtained once via `npm run get-refresh-token` (run locally, not on Railway).
GOOGLE_REFRESH_TOKEN=
# Only used by the local get-refresh-token script — must exactly match
# an "Authorized redirect URI" on the OAuth Client in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:53682/oauth2callback

# ── Gmail Push (Cloud Pub/Sub) ──────────────────────────────────────
# Full resource name: projects/<project-id>/topics/<topic-name>
GOOGLE_PUBSUB_TOPIC=
# Optional shared secret appended to the push endpoint URL as ?token=...
# so random internet traffic can't trigger a fake Gmail notification.
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
# Your Railway deployment's public URL, e.g. https://inbrix-bot-production.up.railway.app
# Used only to print the exact push-subscription endpoint URL for you to
# paste into Cloud Pub/Sub — the app does not create the subscription itself.
PUBLIC_BASE_URL=

# ── Data stores (Railway provides these automatically if you attach the
#    Postgres and Redis plugins — you usually don't need to set them by hand) ─
DATABASE_URL=
REDIS_URL=

# ── Tuning (all optional, sane defaults baked in) ───────────────────
POLL_INTERVAL_MS=45000
WATCHDOG_INTERVAL_MS=300000
WATCHDOG_STALL_THRESHOLD_MS=600000
PORT=3000
BOT_VERSION=0.1.2
